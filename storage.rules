rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Bug report screenshots are user-scoped and require authentication.
    match /reports/{userId}/{allPaths=**} {
      allow read: if request.auth != null
        && (
          request.auth.uid == userId
          || request.auth.token.keys().hasAny(['admin'])
        );
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Allow users to manage their own profile pictures
    match /profile-pictures/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Allow authenticated users to download assessment resumes
    match /assessment-resumes/{allPaths=**} {
      allow read: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}

