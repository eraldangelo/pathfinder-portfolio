{
  "name": "pathfinder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:reset": "powershell -ExecutionPolicy Bypass -File scripts/dev-reset.ps1",
    "dev:fresh": "npm run dev:reset && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "typecheck:api:strict": "tsc -p tsconfig.api-strict.json --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "check:java": "node scripts/check-java-runtime.cjs",
    "test:rules": "npm run check:java && npx --yes firebase-tools@15.5.1 emulators:exec --project demo-pathfinder-rules --only firestore,storage \"node scripts/run-rules-tests.cjs\"",
    "test:e2e:smoke": "playwright test e2e/smoke --reporter=line",
    "check:firestore-indexes": "node scripts/check-firestore-indexes.mjs",
    "check:firebase-config": "node scripts/check-firebase-config.cjs",
    "check:firestore-rules-contract": "node scripts/check-firestore-rules-contract.cjs",
    "check:max-lines": "tsx scripts/quality/check-max-lines.ts",
    "check:secrets": "node scripts/check-secrets.cjs",
    "check:unused-exports": "node scripts/check-unused-exports.cjs",
    "check:required-docs": "node scripts/check-required-docs.cjs",
    "check:legal-notice": "node scripts/check-legal-notice.cjs",
    "check:env-example": "node scripts/check-env-example.cjs",
    "postdeploy:check": "node scripts/postdeploy-check.cjs",
    "ops:check:deploy-drift": "node scripts/ops/check-deploy-drift.cjs",
    "ops:ensure:alerting": "node scripts/ops/ensure-production-alerting.cjs",
    "ops:enforce:app-check": "node scripts/ops/enforce-app-check.cjs",
    "deploy:prod": "node scripts/deploy-prod.cjs",
    "doctor": "node scripts/doctor.cjs",
    "cleanup:preferred-courses": "node scripts/cleanup-preferred-courses.cjs --dry-run",
    "cleanup:preferred-courses:apply": "node scripts/cleanup-preferred-courses.cjs --apply",
    "cleanup:lead-sources": "node scripts/cleanup-lead-sources.cjs --dry-run",
    "cleanup:lead-sources:apply": "node scripts/cleanup-lead-sources.cjs --apply",
    "cleanup:lead-sources:active": "node scripts/cleanup-lead-sources.cjs --dry-run --active-only",
    "cleanup:lead-sources:active:apply": "node scripts/cleanup-lead-sources.cjs --apply --active-only",
    "migrate:education-providers": "tsx scripts/migrate-education-providers-to-firestore.ts",
    "migrate:education-providers:apply": "tsx scripts/migrate-education-providers-to-firestore.ts --apply",
    "archive:move-archived-leads": "node scripts/move-archived-leads-to-rollovers.cjs --dry-run",
    "archive:move-archived-leads:apply": "node scripts/move-archived-leads-to-rollovers.cjs --apply",
    "migrate:personnel-approval-fields": "node scripts/backfill-personnel-approval-fields.cjs",
    "migrate:personnel-approval-fields:verify": "node scripts/backfill-personnel-approval-fields.cjs --verify",
    "migrate:personnel-approval-fields:verify:strict": "node scripts/backfill-personnel-approval-fields.cjs --verify --strict",
    "migrate:personnel-approval-fields:apply": "node scripts/backfill-personnel-approval-fields.cjs --apply",
    "hooks:setup": "node scripts/setup-githooks.cjs",
    "verify": "npm run check:firestore-indexes && npm run check:firebase-config && npm run check:firestore-rules-contract && npm run typecheck && npm run typecheck:api:strict && npm run lint && npm run check:max-lines && npm run check:secrets && npm run check:unused-exports && npm run check:required-docs && npm run check:legal-notice && npm run check:env-example && npm run test && npm run build",
    "verify:smoke": "npm run verify && npm run test:e2e:smoke"
  },
  "dependencies": {
    "@deck.gl/aggregation-layers": "^9.3.0",
    "@deck.gl/google-maps": "^9.3.0",
    "@googlemaps/markerclusterer": "^2.6.2",
    "exceljs": "^4.4.0",
    "firebase": "^12.12.0",
    "firebase-admin": "^13.8.0",
    "flag-icons": "^7.5.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "leaflet": "1.9.4",
    "leaflet.heat": "^0.2.0",
    "next": "16.1.7",
    "ol": "^10.8.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "4.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.56.1",
    "@types/leaflet": "^1.9.0",
    "@types/node": "^22.14.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.1.7",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "ts-prune": "^0.10.3",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  },
  "overrides": {
    "node-forge": "^1.4.0",
    "fast-xml-parser": "^5.5.10",
    "dompurify": "^3.3.3",
    "brace-expansion": "^2.0.3",
    "flatted": "^3.4.2",
    "picomatch": "^4.0.4",
    "yaml": "^2.8.3",
    "lodash": "^4.17.24"
  }
}
